// PodTest Network — Prisma schema (Milestone 1 + 2.1)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  MEMBER
  MODERATOR
  ADMIN
}

/// Account-level AI credit entitlement (independent of staffRole).
enum AiUsagePolicy {
  STANDARD
  UNLIMITED_INTERNAL
}

enum PublicationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  UNPUBLISHED
}

enum ReviewDecisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CapabilitySource {
  PLAN
  STAFF_GIFT
  PROMOTIONAL
  DEV_SEED
}

enum AiJobKind {
  PROFILE_PREPARE
  ARAYANLAR_PREPARE
}

enum AiJobStatus {
  QUEUED
  RUNNING
  READY
  FAILED
  CANCELLED
}

enum CreditLotSource {
  SPONSORED_PROFILE_PREPARE
  SPONSORED_ARAYANLAR_PREPARE
  PLATFORM_HOST_ARAYANLAR
  MONTHLY
  PURCHASED
  STAFF_GIFT
}

enum ArayanlarApplicationStatus {
  DRAFT
  AWAITING_CONFIRMATION
  SUBMITTED
  WITHDRAWN
}

enum ArayanlarPrepStatus {
  NOT_STARTED
  QUEUED
  RUNNING
  READY
  FAILED
  CANCELLED
}

enum ArayanlarArtifactKind {
  GUEST_BRIEF
  HOST_PACK
}

enum CreditEntryType {
  GRANT
  RESERVE
  SETTLE
  RELEASE
}

enum AutomatedReviewOutcome {
  CLEAR
  NEEDS_REVIEW
  LIKELY_VIOLATION
  UNAVAILABLE
}

enum CvExtractionStatus {
  PENDING
  OK
  UNSUPPORTED
  ENCRYPTED
  EMPTY_SCANNED
  MALFORMED
  ERROR
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  staffRole     StaffRole @default(MEMBER)
  /// AI credit entitlement — set only via ops CLI; never self-serve.
  aiUsagePolicy AiUsagePolicy @default(STANDARD)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions         Session[]
  accounts         Account[]
  profile          Profile?
  capabilityGrants CapabilityGrant[]
  reviewsResolved  PublicationReview[] @relation("ReviewResolver")
  cvDocuments      CvDocument[]
  aiJobs           AiJob[]
  creditLots       CreditLot[]
  creditEntries    CreditLedgerEntry[]
  hostAuthorization HostAuthorization?
  arayanlarApplications ArayanlarApplication[] @relation("ArayanlarApplicant")
  assignedApplications  ArayanlarApplication[] @relation("ArayanlarAssignedHost")
  scheduledRecordings   ArayanlarApplication[] @relation("ArayanlarScheduleSetter")
  hostGrantsIssued      HostAuthorization[]    @relation("HostGrantIssuer")

  messagingPreferences MessagingPreferences?
  messageRequestsSent     MessageRequest[] @relation("MessageRequestSender")
  messageRequestsReceived MessageRequest[] @relation("MessageRequestRecipient")
  conversationParts       ConversationParticipant[]
  messagesSent            DirectMessage[]  @relation("MessageSender")
  blocksCreated           MemberBlock[]    @relation("Blocker")
  blocksReceived          MemberBlock[]    @relation("Blocked")
  contentReportsFiled     ContentReport[]  @relation("ReportReporter")
  moderationDecisions     ModerationDecision[] @relation("ModerationActor")
  moderationAccessLogs    ModerationAccessLog[]
  messageQuotaUses        MessageRequestQuotaUse[]
  messageRateBuckets      MessageRateBucket[]

  communityQuestions      CommunityQuestion[]
  communityAnswers        CommunityAnswer[]
  communityQuotaUses      CommunityQuotaUse[]
  speakerInvitationsCreated SpeakerInvitation[] @relation("SpeakerInvitationCreator")
  speakerInvitationsConsumed SpeakerInvitation[] @relation("SpeakerInvitationConsumer")
  emailVerificationTokens EmailVerificationToken[]
  expertFaqs              ExpertFaq[]            @relation("ExpertFaqOwner")
  expertFaqProposals      ExpertFaq[]            @relation("ExpertFaqProposer")
  podcastEpisodesCreated  PodcastEpisode[]       @relation("PodcastEpisodeCreator")
  podcastFeedsUpdated     PodcastFeedConfig[]    @relation("PodcastFeedUpdater")
  episodeAppearances      EpisodeAppearance[]
  episodeAppearancesProposed EpisodeAppearance[] @relation("AppearanceProposer")
  targetedQuestionsSent   TargetedExpertQuestion[] @relation("TargetedQuestionAsker")
  targetedQuestionsReceived TargetedExpertQuestion[] @relation("TargetedQuestionExpert")
  inAppNotifications      InAppNotification[]

  employerWorkspacesOwned EmployerWorkspace[] @relation("EmployerWorkspaceOwner")
  employerMemberships     EmployerWorkspaceMember[]
  employerInvitationsSent EmployerMembershipInvitation[] @relation("EmployerInviteCreator")
  employerInvitationsUsed EmployerMembershipInvitation[] @relation("EmployerInviteConsumer")
  jobListingsAsContact    JobListing[] @relation("JobListingContact")
  hiringSavedSearches     HiringSavedSearch[]
  hiringCandidateLists    HiringCandidateList[]
  hiringCandidateNotes    HiringCandidateNote[] @relation("HiringNoteAuthor")
  hiringNotesAbout        HiringCandidateNote[] @relation("HiringNoteSubject")
  legalAcceptances        LegalAcceptance[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  slug        String  @unique
  headline    String?
  bio         String?
  skills      String[] @default([])
  interests   String[] @default([])
  experience  Json?
  education   Json?
  projects    Json?
  languages   Json?
  location    String?
  workPreferences String?
  publicLinks Json?

  openToWork      Boolean @default(false)
  hiring          Boolean @default(false)
  openToProjects  Boolean @default(false)
  discoverable    Boolean @default(true)

  publicationStatus PublicationStatus @default(DRAFT)
  published         Boolean           @default(false)
  rejectionReason   String?

  /// Approved public snapshot used for /u/[slug] and directory. Never expose draft diffs.
  publicSnapshot Json?
  approvedAt     DateTime?

  /// Incremented on every private draft mutation for conflict detection with AI jobs.
  draftRevision Int @default(0)

  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?

  /// Speaker participation from invitation acceptance — not staff/host/employer access.
  speakerParticipation Boolean @default(false)
  /// Optional expert discussion areas (product UI; not professional qualification verification).
  expertDiscussionAreas String[] @default([])
  acceptTargetedQuestions Boolean @default(false)
  consultationUrl       String?
  consultationPaid      Boolean @default(false)
  /// Member controls whether confirmed podcast appearances render on public profile.
  showAppearancesOnProfile Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews            PublicationReview[]
  aiJobs             AiJob[]
  automatedReviews   AutomatedContentReview[]

  @@index([published, discoverable, publicationStatus])
  @@index([slug])
  @@map("profile")
}

model PublicationReview {
  id        String @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  status             ReviewDecisionStatus @default(PENDING)
  submittedSnapshot  Json
  submittedDraftRevision Int @default(0)
  snapshotHash       String @default("")
  moderationPolicyVersion String
  reason             String?
  reviewerId         String?
  reviewer           User?    @relation("ReviewResolver", fields: [reviewerId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  automatedReview AutomatedContentReview?

  @@index([status, createdAt])
  @@index([profileId])
  @@map("publication_review")
}

model CapabilityGrant {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  capabilityKey String
  source        CapabilitySource
  planCode      String?
  provenance    String
  expiresAt     DateTime?
  createdAt     DateTime         @default(now())
  revokedAt     DateTime?

  @@index([userId, capabilityKey])
  @@map("capability_grant")
}

model ModerationPolicy {
  version     String   @id
  title       String
  body        String
  effectiveAt DateTime @default(now())

  @@map("moderation_policy")
}

model CvDocument {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFilename String
  storedFilename   String
  mimeType         String
  byteSize         Int
  sha256           String
  extractionStatus CvExtractionStatus @default(PENDING)
  extractionErrorCode String?
  extractedTextChars  Int?
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())

  jobs AiJob[]

  @@index([userId, createdAt])
  @@map("cv_document")
}

model AiJob {
  id                   String      @id @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Required for PROFILE_PREPARE; optional for ARAYANLAR_PREPARE (CV/profile not required).
  profileId            String?
  profile              Profile?    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind                 AiJobKind
  status               AiJobStatus @default(QUEUED)
  attemptCount         Int         @default(0)
  maxAttempts          Int         @default(3)
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  cvDocumentId         String?
  cvDocument           CvDocument? @relation(fields: [cvDocumentId], references: [id], onDelete: SetNull)
  /// Private storage path for input text (CV extract or paste). Never logged.
  inputTextRelativePath String?
  profileDraftRevision Int         @default(0)
  creditCostSnapshot   Int
  reservationEntryId   String?     @unique
  resultJson           Json?
  resultConflict       Boolean     @default(false)
  safeErrorCode        String?
  safeErrorMessage     String?
  providerMode         String?
  createdAt            DateTime    @default(now())
  startedAt            DateTime?
  finishedAt           DateTime?
  cancelledAt          DateTime?
  updatedAt            DateTime    @updatedAt

  ledgerEntries CreditLedgerEntry[]
  arayanlarApplicationId String?
  arayanlarApplication   ArayanlarApplication? @relation(fields: [arayanlarApplicationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([leaseExpiresAt])
  @@index([arayanlarApplicationId])
  @@map("ai_job")
}

model CreditLot {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  source          CreditLotSource
  idempotencyKey  String          @unique
  originalAmount  Int
  remainingAmount Int
  reservedAmount  Int             @default(0)
  expiresAt       DateTime?
  provenance      String
  createdAt       DateTime        @default(now())

  entries CreditLedgerEntry[]

  @@index([userId, source])
  @@map("credit_lot")
}

model CreditLedgerEntry {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lotId          String
  lot            CreditLot       @relation(fields: [lotId], references: [id], onDelete: Cascade)
  type           CreditEntryType
  amount         Int
  jobId          String?
  job            AiJob?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([jobId])
  @@map("credit_ledger_entry")
}

model AutomatedContentReview {
  id                   String                  @id @default(cuid())
  publicationReviewId  String                  @unique
  publicationReview    PublicationReview       @relation(fields: [publicationReviewId], references: [id], onDelete: Cascade)
  profileId            String
  profile              Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reviewedDraftRevision Int
  snapshotHash         String
  policyVersion        String
  outcome              AutomatedReviewOutcome
  reasonCodes          String[]                @default([])
  summaryForAdmin      String
  providerMode         String
  createdAt            DateTime                @default(now())

  @@index([profileId, createdAt])
  @@map("automated_content_review")
}

model HostAuthorization {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedByUserId String
  grantedBy       User      @relation("HostGrantIssuer", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  provenance      String
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@map("host_authorization")
}

model ArayanlarApplication {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("ArayanlarApplicant", fields: [userId], references: [id], onDelete: Cascade)

  status     ArayanlarApplicationStatus @default(DRAFT)
  prepStatus ArayanlarPrepStatus        @default(NOT_STARTED)

  /// Conversation + draft answers before confirmation.
  draftAnswers       Json @default("{}")
  conversationTurns  Json @default("[]")
  questionsAsked     Int  @default(0)
  useSummaryFallback Boolean @default(false)

  /// Immutable member-confirmed facts for a submitted revision.
  submittedFacts          Json?
  submittedRevision       Int       @default(0)
  submittedAt             DateTime?
  confirmedCostAt         DateTime?
  editorialTemplateVersion String   @default("arayanlar-18m-v1")

  withdrawnAt DateTime?

  assignedHostUserId String?
  assignedHost       User?     @relation("ArayanlarAssignedHost", fields: [assignedHostUserId], references: [id], onDelete: SetNull)
  assignedAt         DateTime?
  assignedByUserId   String?

  prepareJobId String?

  /// Planned recording instant (UTC). Null = unscheduled / cancelled.
  recordingScheduledAt       DateTime?
  recordingTimezone          String?
  recordingMeetingUrl        String?
  recordingSchedulingNote    String?
  recordingScheduledByUserId String?
  recordingScheduledBy       User?     @relation("ArayanlarScheduleSetter", fields: [recordingScheduledByUserId], references: [id], onDelete: SetNull)
  recordingScheduleUpdatedAt DateTime?
  /// Bumped on each schedule/reschedule/cancel mutation for notification dedupe.
  recordingScheduleVersion   Int       @default(0)
  recordingCompletedAt       DateTime?

  /// Linked draft/public PodcastEpisode for Kariyer Portresi publication review.
  publicationEpisodeId           String?
  publicationEpisode             PodcastEpisode? @relation(fields: [publicationEpisodeId], references: [id], onDelete: SetNull)
  /// When set, candidate may review/approve this exact publicationVersionId.
  publicationReviewRequestedAt   DateTime?
  publicationReviewVersionId     String?
  publicationChangeRequestNote   String?
  publicationChangeRequestedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artifacts ArayanlarArtifact[]
  aiJobs    AiJob[]

  @@index([status, createdAt])
  @@index([assignedHostUserId])
  @@index([recordingScheduledAt])
  @@index([publicationEpisodeId])
  @@map("arayanlar_application")
}

model ArayanlarArtifact {
  id            String                @id @default(cuid())
  applicationId String
  application   ArayanlarApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          ArayanlarArtifactKind
  submittedRevision Int
  editorialTemplateVersion String
  generatedJson Json
  /// Host-only edits; never overwrite generatedJson silently on regeneration of a new revision.
  hostEditedJson Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([applicationId, kind, submittedRevision])
  @@index([applicationId, kind])
  @@map("arayanlar_artifact")
}

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ConversationMessagingState {
  ACTIVE
  PAUSED
}

enum DirectMessageDeliveryStatus {
  DELIVERED
  HELD
  REJECTED_PRE_DELIVERY
  REMOVED
}

enum ReportTargetType {
  MESSAGE_REQUEST
  MESSAGE
  PROFILE
  COMMUNITY_QUESTION
  COMMUNITY_ANSWER
  EXPERT_FAQ
  JOB_LISTING
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum ModerationCaseStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum ModerationHoldKind {
  MESSAGE_REQUEST
  MESSAGE
  COMMUNITY_QUESTION
  COMMUNITY_ANSWER
  EXPERT_FAQ
  JOB_LISTING
}

enum ModerationHoldStatus {
  HELD
  RELEASED
  REJECTED
}

/// Member contact / messaging preferences (server-enforced).
model MessagingPreferences {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  acceptMessageRequests Boolean @default(true)
  /// Temporary platform restriction from moderation (blocks sending/requesting).
  messagingRestrictedUntil DateTime?

  updatedAt DateTime @updatedAt

  @@map("messaging_preferences")
}

model MessageRequest {
  id          String               @id @default(cuid())
  senderId    String
  sender      User                 @relation("MessageRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User                 @relation("MessageRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  /// Lexicographically sorted "low:high" member pair key.
  pairKey     String
  status      MessageRequestStatus @default(PENDING)
  introduction String
  idempotencyKey String
  /// Resumption of a paused conversation after unblock (reuses history).
  isResumption Boolean @default(false)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([senderId, idempotencyKey])
  @@index([recipientId, status, createdAt])
  @@index([senderId, status, createdAt])
  @@index([pairKey, status])
  @@map("message_request")
}

model Conversation {
  id                 String                     @id @default(cuid())
  participantLowId   String
  participantHighId  String
  messagingState     ConversationMessagingState @default(ACTIVE)
  lastMessageAt      DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  participants ConversationParticipant[]
  messages     DirectMessage[]
  requests     MessageRequest[]

  @@unique([participantLowId, participantHighId])
  @@index([lastMessageAt])
  @@map("conversation")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Monotonic watermark: only advance lastReadCreatedAt / lastReadMessageId forward.
  lastReadMessageId  String?
  lastReadCreatedAt  DateTime?
  joinedAt       DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participant")
}

model DirectMessage {
  id             String                     @id @default(cuid())
  conversationId String
  conversation   Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                       @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String?
  deliveryStatus DirectMessageDeliveryStatus @default(DELIVERED)
  removedPlaceholder String?
  idempotencyKey String
  createdAt      DateTime @default(now())

  @@unique([senderId, idempotencyKey])
  @@index([conversationId, createdAt, id])
  @@map("direct_message")
}

model MemberBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("member_block")
}

model MessageRequestCooldown {
  pairKey   String   @id
  until     DateTime
  reason    String
  updatedAt DateTime @updatedAt

  @@map("message_request_cooldown")
}

model MessageRequestQuotaUse {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  yearMonth      String
  requestId      String?
  idempotencyKey String
  createdAt      DateTime @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, yearMonth])
  @@map("message_request_quota_use")
}

/// Sliding window send rate limiting (per-minute buckets).
model MessageRateBucket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucketKey String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, bucketKey])
  @@map("message_rate_bucket")
}

model ContentReport {
  id            String          @id @default(cuid())
  reporterId    String
  reporter      User            @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType    ReportTargetType
  targetId      String
  reasonCode    String
  explanation   String?
  /// Minimal evidence for review — not full conversation/CV.
  evidenceSnapshot Json
  status        ReportStatus    @default(OPEN)
  dedupeKey     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  moderationCase ModerationCase?

  @@unique([reporterId, dedupeKey])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("content_report")
}

model ModerationCase {
  id         String               @id @default(cuid())
  reportId   String               @unique
  report     ContentReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status     ModerationCaseStatus @default(OPEN)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  decisions ModerationDecision[]
  holds     ModerationHold[]

  @@index([status, createdAt])
  @@map("moderation_case")
}

model ModerationDecision {
  id        String         @id @default(cuid())
  caseId    String
  case      ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User           @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  note      String?
  createdAt DateTime       @default(now())

  @@index([caseId, createdAt])
  @@map("moderation_decision")
}

model ModerationHold {
  id              String               @id @default(cuid())
  kind            ModerationHoldKind
  status          ModerationHoldStatus @default(HELD)
  /// Pending payload until release creates/delivers the real record.
  payload         Json
  senderId        String
  recipientId     String?
  conversationId  String?
  idempotencyKey  String?
  caseId          String?
  case            ModerationCase?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  resolvedAt      DateTime?

  @@index([status, createdAt])
  @@index([senderId, status])
  @@map("moderation_hold")
}

model ModerationAccessLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  targetType String
  targetId  String
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@map("moderation_access_log")
}

// ---------------------------------------------------------------------------
// Milestone 3.2 — Community Q&A, speaker invitations, expert FAQs, episodes
// ---------------------------------------------------------------------------

enum CommunityContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  REMOVED_BY_OWNER
  REMOVED_BY_MODERATOR
}

enum CommunityQuotaKind {
  QUESTION
  ANSWER
}

enum SpeakerInvitationPurpose {
  SPEAKER_STATUS
  EPISODE_ASSOCIATION
}

enum ExpertFaqStatus {
  DRAFT
  PENDING_EXPERT_APPROVAL
  PENDING_MODERATION
  PUBLISHED
  REJECTED
  REMOVED
}

enum PodcastEpisodePublicationState {
  DRAFT
  PUBLISHED
  REMOVED
}

enum EpisodeAppearanceStatus {
  PENDING_ADMIN
  PENDING_MEMBER
  CONFIRMED
  REJECTED
  REVOKED
}

enum EpisodeAppearanceRequester {
  MEMBER
  ADMIN
}

enum TargetedQuestionStatus {
  OPEN
  DECLINED
  ANSWERED
  HIDDEN
}

model CommunityQuestion {
  id              String                 @id @default(cuid())
  authorId        String
  author          User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Public author display name snapshot at publish time (profile may stay unpublished).
  authorDisplayName String
  title           String
  body            String
  topicTags       String[]               @default([])
  episodeId       String?
  episode         PodcastEpisode?        @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  status          CommunityContentStatus @default(DRAFT)
  /// Revision currently visible publicly when status is PUBLISHED.
  publishedRevision Int?
  /// Latest submitted revision awaiting or under moderation.
  currentRevision   Int                  @default(0)
  moderationReason  String?
  moderationPolicyVersion String?
  moderationAdapter     String?
  removedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  publishedAt       DateTime?

  revisions CommunityQuestionRevision[]
  answers   CommunityAnswer[]
  targeted  TargetedExpertQuestion[]

  @@index([status, publishedAt])
  @@index([authorId, createdAt])
  @@index([episodeId])
  @@map("community_question")
}

model CommunityQuestionRevision {
  id           String            @id @default(cuid())
  questionId   String
  question     CommunityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  revision     Int
  title        String
  body         String
  topicTags    String[]          @default([])
  episodeId    String?
  /// Exact classification for this revision.
  classificationOutcome String?
  classificationReason  String?
  moderationDecision    String?
  createdAt    DateTime          @default(now())

  @@unique([questionId, revision])
  @@map("community_question_revision")
}

model CommunityAnswer {
  id                String                 @id @default(cuid())
  questionId        String
  question          CommunityQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId          String
  author            User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorDisplayName String
  body              String
  status            CommunityContentStatus @default(DRAFT)
  publishedRevision Int?
  currentRevision   Int                    @default(0)
  moderationReason  String?
  moderationPolicyVersion String?
  moderationAdapter     String?
  removedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  publishedAt       DateTime?

  revisions CommunityAnswerRevision[]

  @@index([questionId, status, publishedAt])
  @@index([authorId, createdAt])
  @@map("community_answer")
}

model CommunityAnswerRevision {
  id           String          @id @default(cuid())
  answerId     String
  answer       CommunityAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  revision     Int
  body         String
  classificationOutcome String?
  classificationReason  String?
  moderationDecision    String?
  createdAt    DateTime        @default(now())

  @@unique([answerId, revision])
  @@map("community_answer_revision")
}

model CommunityQuotaUse {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           CommunityQuotaKind
  /// UTC calendar day YYYY-MM-DD
  dayKey         String
  contentId      String
  idempotencyKey String
  createdAt      DateTime           @default(now())

  @@unique([userId, kind, idempotencyKey])
  @@index([userId, kind, dayKey])
  @@map("community_quota_use")
}

/// Local mail-sink email verification (no real outbound mail in this milestone).
model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hex of the plaintext token — never store reusable plaintext.
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("email_verification_token")
}

model SpeakerInvitation {
  id              String                    @id @default(cuid())
  createdById     String
  createdBy       User                      @relation("SpeakerInvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  /// Optional binding — acceptance requires verified account email match.
  recipientEmail  String?
  purpose         SpeakerInvitationPurpose
  episodeId       String?
  episode         PodcastEpisode?           @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  /// SHA-256 hex of invitation token.
  tokenHash       String                    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  consumedAt      DateTime?
  consumedById    String?
  consumedBy      User?                     @relation("SpeakerInvitationConsumer", fields: [consumedById], references: [id], onDelete: SetNull)
  note            String?
  createdAt       DateTime                  @default(now())

  @@index([createdById, createdAt])
  @@index([recipientEmail])
  @@map("speaker_invitation")
}

model ExpertFaq {
  id                    String         @id @default(cuid())
  expertUserId          String
  expert                User           @relation("ExpertFaqOwner", fields: [expertUserId], references: [id], onDelete: Cascade)
  /// Optional admin who proposed the draft (still requires expert approval of exact revision).
  proposedByAdminId     String?
  proposedByAdmin       User?          @relation("ExpertFaqProposer", fields: [proposedByAdminId], references: [id], onDelete: SetNull)
  question              String
  answer                String
  currentRevision       Int            @default(1)
  /// Exact revision the expert approved; null until expert approval.
  expertApprovedRevision Int?
  expertApprovedAt      DateTime?
  status                ExpertFaqStatus @default(DRAFT)
  moderationOutcome     String?
  moderationReason      String?
  moderationPolicyVersion String?
  moderationAdapter     String?
  publishedAt           DateTime?
  removedAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  revisions ExpertFaqRevision[]

  @@index([expertUserId, status])
  @@index([status, publishedAt])
  @@map("expert_faq")
}

model ExpertFaqRevision {
  id         String    @id @default(cuid())
  faqId      String
  faq        ExpertFaq @relation(fields: [faqId], references: [id], onDelete: Cascade)
  revision   Int
  question   String
  answer     String
  createdById String?
  createdAt  DateTime  @default(now())

  @@unique([faqId, revision])
  @@map("expert_faq_revision")
}

model PodcastEpisode {
  id               String                         @id @default(cuid())
  series           String
  title            String
  /// Public URL slug (stable after first publish/import when possible).
  slug             String                         @unique
  description      String?
  /// Sanitized HTML description for detail page (strict allowlist). Plain text preferred for cards.
  descriptionHtml  String?
  publicationDate  DateTime?
  /// Canonical page / listening link from feed item <link> or admin (not necessarily Spotify).
  listeningUrl     String?
  /// Validated open.spotify.com episode URL only — never invented from RSS.
  spotifyEpisodeUrl String?
  artworkUrl       String?
  audioUrl         String?
  durationSeconds  Int?
  episodeNumber    Int?
  seasonNumber     Int?
  publicationState PodcastEpisodePublicationState @default(DRAFT)
  sourceKind       PodcastEpisodeSourceKind       @default(MANUAL)
  feedConfigId     String?
  feedConfig       PodcastFeedConfig?             @relation(fields: [feedConfigId], references: [id], onDelete: SetNull)
  /// Stable RSS item identity within feed (GUID or enclosure-URL fallback).
  rssGuid          String?
  /// Last imported field snapshot (JSON) for refresh diffs.
  importedSnapshot Json?
  /// Map of field names curated by admin that RSS refresh must not overwrite.
  manualOverrides  Json?
  createdById      String
  createdBy        User                           @relation("PodcastEpisodeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  appearances  EpisodeAppearance[]
  invitations  SpeakerInvitation[]
  questions    CommunityQuestion[]
  arayanlarApplications ArayanlarApplication[]

  @@unique([feedConfigId, rssGuid])
  @@index([publicationState, publicationDate])
  @@index([series])
  @@index([audioUrl])
  @@index([listeningUrl])
  @@map("podcast_episode")
}

enum PodcastEpisodeSourceKind {
  MANUAL
  RSS
}

model PodcastFeedConfig {
  id              String    @id @default(cuid())
  /// Admin-configured HTTPS feed URL.
  feedUrl         String
  /// Stable feed identity (prefer atom:link rel=self).
  feedIdentity    String?   @unique
  feedTitle       String?
  lastFetchedAt   DateTime?
  lastFetchStatus String?
  lastFetchError  String?
  lastItemCount   Int?
  updatedById     String?
  updatedBy       User?     @relation("PodcastFeedUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  episodes PodcastEpisode[]

  @@map("podcast_feed_config")
}

model EpisodeAppearance {
  id              String                     @id @default(cuid())
  episodeId       String
  episode         PodcastEpisode             @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  memberUserId    String
  member          User                       @relation(fields: [memberUserId], references: [id], onDelete: Cascade)
  status          EpisodeAppearanceStatus
  requestedBy     EpisodeAppearanceRequester
  proposedById    String?
  proposedBy      User?                      @relation("AppearanceProposer", fields: [proposedById], references: [id], onDelete: SetNull)
  creditLabel     String?
  /// Admin verification timestamp (member self-edit cannot set this).
  adminVerifiedAt DateTime?
  memberAcceptedAt DateTime?
  rejectedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([episodeId, memberUserId])
  @@index([memberUserId, status])
  @@index([status, createdAt])
  @@map("episode_appearance")
}

model TargetedExpertQuestion {
  id           String                 @id @default(cuid())
  askerId      String
  asker        User                   @relation("TargetedQuestionAsker", fields: [askerId], references: [id], onDelete: Cascade)
  expertUserId String
  expert       User                   @relation("TargetedQuestionExpert", fields: [expertUserId], references: [id], onDelete: Cascade)
  questionId   String?
  question     CommunityQuestion?     @relation(fields: [questionId], references: [id], onDelete: SetNull)
  body         String
  status       TargetedQuestionStatus @default(OPEN)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([expertUserId, status, createdAt])
  @@index([askerId, createdAt])
  @@map("targeted_expert_question")
}

model InAppNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  href      String?
  payload   Json?
  /// Event-level idempotency key; null rows are legacy and not deduped.
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("in_app_notification")
}

// ---------------------------------------------------------------------------
// Milestone 3.3 — Employer workspaces, job listings, hiring discovery
// ---------------------------------------------------------------------------

enum EmployerWorkspaceStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum EmployerWorkspaceRole {
  OWNER
  RECRUITER
}

enum EmployerWorkspaceMemberStatus {
  ACTIVE
  REMOVED
}

enum JobListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  CLOSED
  REMOVED
}

enum JobRemoteType {
  REMOTE
  HYBRID
  ON_SITE
  UNSPECIFIED
}

enum JobEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobApplicationMethod {
  EXTERNAL_URL
  MESSAGING
}

enum JobSalaryPeriod {
  HOURLY
  MONTHLY
  YEARLY
}

model EmployerWorkspace {
  id          String                  @id @default(cuid())
  name        String
  description String?
  website     String?
  status      EmployerWorkspaceStatus @default(ACTIVE)
  ownerId     String
  owner       User                    @relation("EmployerWorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  members     EmployerWorkspaceMember[]
  invitations EmployerMembershipInvitation[]
  jobs        JobListing[]
  savedSearches HiringSavedSearch[]
  candidateLists HiringCandidateList[]
  candidateNotes HiringCandidateNote[]

  @@index([ownerId])
  @@index([status])
  @@map("employer_workspace")
}

model EmployerWorkspaceMember {
  id          String                        @id @default(cuid())
  workspaceId String
  workspace   EmployerWorkspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        EmployerWorkspaceRole
  status      EmployerWorkspaceMemberStatus @default(ACTIVE)
  removedAt   DateTime?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@map("employer_workspace_member")
}

model EmployerMembershipInvitation {
  id             String                @id @default(cuid())
  workspaceId    String
  workspace      EmployerWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User                  @relation("EmployerInviteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  recipientEmail String?
  role           EmployerWorkspaceRole @default(RECRUITER)
  tokenHash      String                @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  consumedAt     DateTime?
  consumedById   String?
  consumedBy     User?                 @relation("EmployerInviteConsumer", fields: [consumedById], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())

  @@index([workspaceId, createdAt])
  @@map("employer_membership_invitation")
}

model JobListing {
  id              String               @id @default(cuid())
  workspaceId     String
  workspace       EmployerWorkspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug            String               @unique
  title           String
  description     String
  responsibilities String?
  skills          String[]             @default([])
  location        String?
  remoteType      JobRemoteType        @default(UNSPECIFIED)
  employmentType  JobEmploymentType    @default(FULL_TIME)
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?
  salaryPeriod    JobSalaryPeriod?
  applicationMethod JobApplicationMethod
  applicationUrl  String?
  contactUserId   String?
  contactUser     User?                @relation("JobListingContact", fields: [contactUserId], references: [id], onDelete: SetNull)
  closingDate     DateTime?
  status          JobListingStatus     @default(DRAFT)
  publishedRevision Int?
  currentRevision   Int                @default(0)
  moderationReason  String?
  moderationPolicyVersion String?
  moderationAdapter     String?
  publishedAt     DateTime?
  closedAt        DateTime?
  removedAt       DateTime?
  createdById     String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  revisions JobListingRevision[]

  @@index([workspaceId, status])
  @@index([status, publishedAt])
  @@map("job_listing")
}

model JobListingRevision {
  id           String     @id @default(cuid())
  jobId        String
  job          JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  revision     Int
  payload      Json
  classificationOutcome String?
  classificationReason  String?
  moderationDecision    String?
  createdAt    DateTime   @default(now())

  @@unique([jobId, revision])
  @@map("job_listing_revision")
}

model HiringSavedSearch {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   EmployerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  filters     Json
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([workspaceId, createdAt])
  @@map("hiring_saved_search")
}

model HiringCandidateList {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   EmployerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  entries HiringCandidateListEntry[]

  @@index([workspaceId, createdAt])
  @@map("hiring_candidate_list")
}

model HiringCandidateListEntry {
  id          String              @id @default(cuid())
  listId      String
  list        HiringCandidateList @relation(fields: [listId], references: [id], onDelete: Cascade)
  subjectUserId String
  addedById   String
  createdAt   DateTime            @default(now())

  @@unique([listId, subjectUserId])
  @@index([subjectUserId])
  @@map("hiring_candidate_list_entry")
}

model HiringCandidateNote {
  id            String            @id @default(cuid())
  workspaceId   String
  workspace     EmployerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subjectUserId String
  subject       User              @relation("HiringNoteSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  authorId      String
  author        User              @relation("HiringNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([workspaceId, subjectUserId])
  @@index([authorId, createdAt])
  @@map("hiring_candidate_note")
}

// ---------------------------------------------------------------------------
// Legal & Privacy Foundation — versioned documents and acceptances
// ---------------------------------------------------------------------------

enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_NOTICE
  CV_AI_PROCESSING_NOTICE
  CV_AI_CONSENT
  PROFILE_VISIBILITY_NOTICE
  HOST_PREP_SHARING_NOTICE
  RECORDING_CONSENT
  PUBLICATION_APPROVAL
  MARKETING_CONSENT
  RECORDING_AND_PUBLICATION_NOTICE
}

enum LegalAcceptanceType {
  TERMS
  PRIVACY_NOTICE
  CV_AI_PROCESSING
  CV_AI_CONSENT
  PROFILE_VISIBILITY
  HOST_PREP_SHARING
  RECORDING
  PUBLICATION
  MARKETING
}

model LegalDocument {
  id                   String            @id @default(cuid())
  type                 LegalDocumentType
  version              String
  locale               String            @default("tr")
  title                String
  summary              String?
  /// Full draft body (markdown). Final counsel review required before production publication.
  bodyMarkdown         String
  effectiveFrom        DateTime          @default(now())
  retiredAt            DateTime?
  /// When true, users with an older acceptance must re-accept before gated actions.
  requiresReacceptance Boolean           @default(true)
  createdAt            DateTime          @default(now())

  @@unique([type, version, locale])
  @@index([type, locale, effectiveFrom])
  @@map("legal_document")
}

model LegalAcceptance {
  id                   String               @id @default(cuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 LegalAcceptanceType
  documentType         LegalDocumentType
  documentVersion      String
  /// Stable key: `{documentType}:{version}:{locale}`
  documentKey          String
  scope                String?
  relatedResourceType  String?
  relatedResourceId    String?
  acceptedAt           DateTime             @default(now())
  withdrawnAt          DateTime?
  /// Optional non-sensitive metadata (e.g. publicationVersionId). No secrets.
  metadata             Json?

  @@index([userId, type, withdrawnAt])
  @@index([userId, documentKey])
  @@index([relatedResourceType, relatedResourceId])
  @@index([type, documentVersion])
  @@map("legal_acceptance")
}
