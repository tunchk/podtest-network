// PodTest Network — Prisma schema (Milestone 1 + 2.1)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum PublicationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  UNPUBLISHED
}

enum ReviewDecisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CapabilitySource {
  PLAN
  STAFF_GIFT
  PROMOTIONAL
  DEV_SEED
}

enum AiJobKind {
  PROFILE_PREPARE
  ARAYANLAR_PREPARE
}

enum AiJobStatus {
  QUEUED
  RUNNING
  READY
  FAILED
  CANCELLED
}

enum CreditLotSource {
  SPONSORED_PROFILE_PREPARE
  SPONSORED_ARAYANLAR_PREPARE
  PLATFORM_HOST_ARAYANLAR
  MONTHLY
  PURCHASED
  STAFF_GIFT
}

enum ArayanlarApplicationStatus {
  DRAFT
  AWAITING_CONFIRMATION
  SUBMITTED
  WITHDRAWN
}

enum ArayanlarPrepStatus {
  NOT_STARTED
  QUEUED
  RUNNING
  READY
  FAILED
  CANCELLED
}

enum ArayanlarArtifactKind {
  GUEST_BRIEF
  HOST_PACK
}

enum CreditEntryType {
  GRANT
  RESERVE
  SETTLE
  RELEASE
}

enum AutomatedReviewOutcome {
  CLEAR
  NEEDS_REVIEW
  LIKELY_VIOLATION
  UNAVAILABLE
}

enum CvExtractionStatus {
  PENDING
  OK
  UNSUPPORTED
  ENCRYPTED
  EMPTY_SCANNED
  MALFORMED
  ERROR
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  staffRole     StaffRole @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions         Session[]
  accounts         Account[]
  profile          Profile?
  capabilityGrants CapabilityGrant[]
  reviewsResolved  PublicationReview[] @relation("ReviewResolver")
  cvDocuments      CvDocument[]
  aiJobs           AiJob[]
  creditLots       CreditLot[]
  creditEntries    CreditLedgerEntry[]
  hostAuthorization HostAuthorization?
  arayanlarApplications ArayanlarApplication[] @relation("ArayanlarApplicant")
  assignedApplications  ArayanlarApplication[] @relation("ArayanlarAssignedHost")
  hostGrantsIssued      HostAuthorization[]    @relation("HostGrantIssuer")

  messagingPreferences MessagingPreferences?
  messageRequestsSent     MessageRequest[] @relation("MessageRequestSender")
  messageRequestsReceived MessageRequest[] @relation("MessageRequestRecipient")
  conversationParts       ConversationParticipant[]
  messagesSent            DirectMessage[]  @relation("MessageSender")
  blocksCreated           MemberBlock[]    @relation("Blocker")
  blocksReceived          MemberBlock[]    @relation("Blocked")
  contentReportsFiled     ContentReport[]  @relation("ReportReporter")
  moderationDecisions     ModerationDecision[] @relation("ModerationActor")
  moderationAccessLogs    ModerationAccessLog[]
  messageQuotaUses        MessageRequestQuotaUse[]
  messageRateBuckets      MessageRateBucket[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  slug        String  @unique
  headline    String?
  bio         String?
  skills      String[] @default([])
  interests   String[] @default([])
  experience  Json?
  education   Json?
  projects    Json?
  languages   Json?
  location    String?
  workPreferences String?
  publicLinks Json?

  openToWork      Boolean @default(false)
  hiring          Boolean @default(false)
  openToProjects  Boolean @default(false)
  discoverable    Boolean @default(true)

  publicationStatus PublicationStatus @default(DRAFT)
  published         Boolean           @default(false)
  rejectionReason   String?

  /// Approved public snapshot used for /u/[slug] and directory. Never expose draft diffs.
  publicSnapshot Json?
  approvedAt     DateTime?

  /// Incremented on every private draft mutation for conflict detection with AI jobs.
  draftRevision Int @default(0)

  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews            PublicationReview[]
  aiJobs             AiJob[]
  automatedReviews   AutomatedContentReview[]

  @@index([published, discoverable, publicationStatus])
  @@index([slug])
  @@map("profile")
}

model PublicationReview {
  id        String @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  status             ReviewDecisionStatus @default(PENDING)
  submittedSnapshot  Json
  submittedDraftRevision Int @default(0)
  snapshotHash       String @default("")
  moderationPolicyVersion String
  reason             String?
  reviewerId         String?
  reviewer           User?    @relation("ReviewResolver", fields: [reviewerId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  automatedReview AutomatedContentReview?

  @@index([status, createdAt])
  @@index([profileId])
  @@map("publication_review")
}

model CapabilityGrant {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  capabilityKey String
  source        CapabilitySource
  planCode      String?
  provenance    String
  expiresAt     DateTime?
  createdAt     DateTime         @default(now())
  revokedAt     DateTime?

  @@index([userId, capabilityKey])
  @@map("capability_grant")
}

model ModerationPolicy {
  version     String   @id
  title       String
  body        String
  effectiveAt DateTime @default(now())

  @@map("moderation_policy")
}

model CvDocument {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFilename String
  storedFilename   String
  mimeType         String
  byteSize         Int
  sha256           String
  extractionStatus CvExtractionStatus @default(PENDING)
  extractionErrorCode String?
  extractedTextChars  Int?
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())

  jobs AiJob[]

  @@index([userId, createdAt])
  @@map("cv_document")
}

model AiJob {
  id                   String      @id @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Required for PROFILE_PREPARE; optional for ARAYANLAR_PREPARE (CV/profile not required).
  profileId            String?
  profile              Profile?    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind                 AiJobKind
  status               AiJobStatus @default(QUEUED)
  attemptCount         Int         @default(0)
  maxAttempts          Int         @default(3)
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  cvDocumentId         String?
  cvDocument           CvDocument? @relation(fields: [cvDocumentId], references: [id], onDelete: SetNull)
  /// Private storage path for input text (CV extract or paste). Never logged.
  inputTextRelativePath String?
  profileDraftRevision Int         @default(0)
  creditCostSnapshot   Int
  reservationEntryId   String?     @unique
  resultJson           Json?
  resultConflict       Boolean     @default(false)
  safeErrorCode        String?
  safeErrorMessage     String?
  providerMode         String?
  createdAt            DateTime    @default(now())
  startedAt            DateTime?
  finishedAt           DateTime?
  cancelledAt          DateTime?
  updatedAt            DateTime    @updatedAt

  ledgerEntries CreditLedgerEntry[]
  arayanlarApplicationId String?
  arayanlarApplication   ArayanlarApplication? @relation(fields: [arayanlarApplicationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([leaseExpiresAt])
  @@index([arayanlarApplicationId])
  @@map("ai_job")
}

model CreditLot {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  source          CreditLotSource
  idempotencyKey  String          @unique
  originalAmount  Int
  remainingAmount Int
  reservedAmount  Int             @default(0)
  expiresAt       DateTime?
  provenance      String
  createdAt       DateTime        @default(now())

  entries CreditLedgerEntry[]

  @@index([userId, source])
  @@map("credit_lot")
}

model CreditLedgerEntry {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lotId          String
  lot            CreditLot       @relation(fields: [lotId], references: [id], onDelete: Cascade)
  type           CreditEntryType
  amount         Int
  jobId          String?
  job            AiJob?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([jobId])
  @@map("credit_ledger_entry")
}

model AutomatedContentReview {
  id                   String                  @id @default(cuid())
  publicationReviewId  String                  @unique
  publicationReview    PublicationReview       @relation(fields: [publicationReviewId], references: [id], onDelete: Cascade)
  profileId            String
  profile              Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reviewedDraftRevision Int
  snapshotHash         String
  policyVersion        String
  outcome              AutomatedReviewOutcome
  reasonCodes          String[]                @default([])
  summaryForAdmin      String
  providerMode         String
  createdAt            DateTime                @default(now())

  @@index([profileId, createdAt])
  @@map("automated_content_review")
}

model HostAuthorization {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedByUserId String
  grantedBy       User      @relation("HostGrantIssuer", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  provenance      String
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@map("host_authorization")
}

model ArayanlarApplication {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("ArayanlarApplicant", fields: [userId], references: [id], onDelete: Cascade)

  status     ArayanlarApplicationStatus @default(DRAFT)
  prepStatus ArayanlarPrepStatus        @default(NOT_STARTED)

  /// Conversation + draft answers before confirmation.
  draftAnswers       Json @default("{}")
  conversationTurns  Json @default("[]")
  questionsAsked     Int  @default(0)
  useSummaryFallback Boolean @default(false)

  /// Immutable member-confirmed facts for a submitted revision.
  submittedFacts          Json?
  submittedRevision       Int       @default(0)
  submittedAt             DateTime?
  confirmedCostAt         DateTime?
  editorialTemplateVersion String   @default("arayanlar-18m-v1")

  withdrawnAt DateTime?

  assignedHostUserId String?
  assignedHost       User?     @relation("ArayanlarAssignedHost", fields: [assignedHostUserId], references: [id], onDelete: SetNull)
  assignedAt         DateTime?
  assignedByUserId   String?

  prepareJobId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artifacts ArayanlarArtifact[]
  aiJobs    AiJob[]

  @@index([status, createdAt])
  @@index([assignedHostUserId])
  @@map("arayanlar_application")
}

model ArayanlarArtifact {
  id            String                @id @default(cuid())
  applicationId String
  application   ArayanlarApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          ArayanlarArtifactKind
  submittedRevision Int
  editorialTemplateVersion String
  generatedJson Json
  /// Host-only edits; never overwrite generatedJson silently on regeneration of a new revision.
  hostEditedJson Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([applicationId, kind, submittedRevision])
  @@index([applicationId, kind])
  @@map("arayanlar_artifact")
}

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ConversationMessagingState {
  ACTIVE
  PAUSED
}

enum DirectMessageDeliveryStatus {
  DELIVERED
  HELD
  REJECTED_PRE_DELIVERY
  REMOVED
}

enum ReportTargetType {
  MESSAGE_REQUEST
  MESSAGE
  PROFILE
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum ModerationCaseStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum ModerationHoldKind {
  MESSAGE_REQUEST
  MESSAGE
}

enum ModerationHoldStatus {
  HELD
  RELEASED
  REJECTED
}

/// Member contact / messaging preferences (server-enforced).
model MessagingPreferences {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  acceptMessageRequests Boolean @default(true)
  /// Temporary platform restriction from moderation (blocks sending/requesting).
  messagingRestrictedUntil DateTime?

  updatedAt DateTime @updatedAt

  @@map("messaging_preferences")
}

model MessageRequest {
  id          String               @id @default(cuid())
  senderId    String
  sender      User                 @relation("MessageRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User                 @relation("MessageRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  /// Lexicographically sorted "low:high" member pair key.
  pairKey     String
  status      MessageRequestStatus @default(PENDING)
  introduction String
  idempotencyKey String
  /// Resumption of a paused conversation after unblock (reuses history).
  isResumption Boolean @default(false)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([senderId, idempotencyKey])
  @@index([recipientId, status, createdAt])
  @@index([senderId, status, createdAt])
  @@index([pairKey, status])
  @@map("message_request")
}

model Conversation {
  id                 String                     @id @default(cuid())
  participantLowId   String
  participantHighId  String
  messagingState     ConversationMessagingState @default(ACTIVE)
  lastMessageAt      DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  participants ConversationParticipant[]
  messages     DirectMessage[]
  requests     MessageRequest[]

  @@unique([participantLowId, participantHighId])
  @@index([lastMessageAt])
  @@map("conversation")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Monotonic watermark: only advance lastReadCreatedAt / lastReadMessageId forward.
  lastReadMessageId  String?
  lastReadCreatedAt  DateTime?
  joinedAt       DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participant")
}

model DirectMessage {
  id             String                     @id @default(cuid())
  conversationId String
  conversation   Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                       @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String?
  deliveryStatus DirectMessageDeliveryStatus @default(DELIVERED)
  removedPlaceholder String?
  idempotencyKey String
  createdAt      DateTime @default(now())

  @@unique([senderId, idempotencyKey])
  @@index([conversationId, createdAt, id])
  @@map("direct_message")
}

model MemberBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("member_block")
}

model MessageRequestCooldown {
  pairKey   String   @id
  until     DateTime
  reason    String
  updatedAt DateTime @updatedAt

  @@map("message_request_cooldown")
}

model MessageRequestQuotaUse {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  yearMonth      String
  requestId      String?
  idempotencyKey String
  createdAt      DateTime @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, yearMonth])
  @@map("message_request_quota_use")
}

/// Sliding window send rate limiting (per-minute buckets).
model MessageRateBucket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucketKey String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, bucketKey])
  @@map("message_rate_bucket")
}

model ContentReport {
  id            String          @id @default(cuid())
  reporterId    String
  reporter      User            @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType    ReportTargetType
  targetId      String
  reasonCode    String
  explanation   String?
  /// Minimal evidence for review — not full conversation/CV.
  evidenceSnapshot Json
  status        ReportStatus    @default(OPEN)
  dedupeKey     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  moderationCase ModerationCase?

  @@unique([reporterId, dedupeKey])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("content_report")
}

model ModerationCase {
  id         String               @id @default(cuid())
  reportId   String               @unique
  report     ContentReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status     ModerationCaseStatus @default(OPEN)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  decisions ModerationDecision[]
  holds     ModerationHold[]

  @@index([status, createdAt])
  @@map("moderation_case")
}

model ModerationDecision {
  id        String         @id @default(cuid())
  caseId    String
  case      ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User           @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  note      String?
  createdAt DateTime       @default(now())

  @@index([caseId, createdAt])
  @@map("moderation_decision")
}

model ModerationHold {
  id              String               @id @default(cuid())
  kind            ModerationHoldKind
  status          ModerationHoldStatus @default(HELD)
  /// Pending payload until release creates/delivers the real record.
  payload         Json
  senderId        String
  recipientId     String?
  conversationId  String?
  idempotencyKey  String?
  caseId          String?
  case            ModerationCase?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  resolvedAt      DateTime?

  @@index([status, createdAt])
  @@index([senderId, status])
  @@map("moderation_hold")
}

model ModerationAccessLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  targetType String
  targetId  String
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@map("moderation_access_log")
}
