# Copy to .env.local for local development. Names only — never commit secrets.

# PostgreSQL (use isolated podtest / podtest_test databases)
DATABASE_URL="postgresql://USER@127.0.0.1:5432/podtest?schema=public"
DATABASE_URL_TEST="postgresql://USER@127.0.0.1:5432/podtest_test?schema=public"

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"

# Catchylabs integration stays unavailable until configured (Milestone 5)
CATCHYLABS_INTEGRATION_ENABLED="false"
# CATCHYLABS_API_BASE_URL=
# CATCHYLABS_SERVICE_TOKEN=

# Milestone 2.1 — AI profile prepare (do not commit secrets)
# Live provider (required for real CV extraction):
# OPENAI_API_KEY=
# OPENAI_MODEL="gpt-4o-mini"
# AI_PROVIDER=openai

# Optional local demo stub — NON-PRODUCTION ONLY. Explicitly enable and UI-labeled.
# Forbidden when NODE_ENV=production (AI_ALLOW_STUB / AI_DEMO_STUB cannot override).
# AI_DEMO_STUB="true"

# PROFILE_PREPARE_CREDIT_COST="1"
# SPONSORED_PROFILE_PREPARE_AMOUNT="1"
# AI_WORKER_POLL_MS="1500"
