# Copy to `.env.local` for local development, or set in the production environment.
# Names and placeholders only — never commit real secrets.

# ---------------------------------------------------------------------------
# Required (web + worker)
# ---------------------------------------------------------------------------

# PostgreSQL connection (app database). Web and worker must share the same DB.
DATABASE_URL="postgresql://USER@127.0.0.1:5432/podtest?schema=public"

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-me-with-a-secure-random-secret"
# Public origin of the web app (no trailing path)
BETTER_AUTH_URL="http://localhost:3000"

# OpenAI (live Kariyer Portresi / profile prepare). Required for real AI prep.
OPENAI_API_KEY=
# Profile-prepare model (M2.1)
OPENAI_MODEL="gpt-4o-mini"
# Kariyer Portresi preparation model (server-only; separate from OPENAI_MODEL)
ARAYANLAR_PREP_MODEL=gpt-5.6-sol

# Persistent file root for CV binaries + AI job inputs (server-only).
# Development default when unset: <cwd>/storage
# Production example (mounted volume): /data/podtest
# STORAGE_ROOT=/data/podtest

# ---------------------------------------------------------------------------
# Required for Kariyer Portresi host handoff (after bootstrap)
# ---------------------------------------------------------------------------

# Production host user id (from DB after bootstrap:host). Do not copy a local dev id.
# KARIYER_PORTRESI_DEFAULT_HOST_USER_ID=

# ---------------------------------------------------------------------------
# Worker process (required when running `npm run worker`)
# ---------------------------------------------------------------------------

# Unique per concurrent worker process
# WORKER_ID=worker-1
# Poll interval when the queue is idle (ms)
# AI_WORKER_POLL_MS=1500

# ---------------------------------------------------------------------------
# Optional — integrations / feature flags
# ---------------------------------------------------------------------------

# Catchylabs stays unavailable until configured
CATCHYLABS_INTEGRATION_ENABLED="false"
# CATCHYLABS_API_BASE_URL=
# CATCHYLABS_SERVICE_TOKEN=

# AI_PROVIDER=openai

# PROFILE_PREPARE_CREDIT_COST="1"
# SPONSORED_PROFILE_PREPARE_AMOUNT="1"
# ARAYANLAR_PREPARE_CREDIT_COST="1"
# SPONSORED_ARAYANLAR_PREPARE_AMOUNT="1"
# HOST_PACK_REGEN_MAX="3"
# HOST_PACK_REGEN_WINDOW_MS="3600000"

# MESSAGE_REQUEST_FREE_MONTHLY_ALLOWANCE="5"
# MESSAGE_REQUEST_PLUS_MONTHLY_ALLOWANCE="40"
# MESSAGE_REQUEST_EMPLOYER_MONTHLY_ALLOWANCE="50"
# MESSAGE_REQUEST_COOLDOWN_DAYS="7"
# MESSAGE_REQUEST_MAX_CHARS="1000"
# DIRECT_MESSAGE_MAX_CHARS="4000"
# MESSAGE_SENDS_PER_MINUTE="20"

# COMMUNITY_QUESTION_TITLE_MAX="160"
# COMMUNITY_QUESTION_BODY_MAX="5000"
# COMMUNITY_ANSWER_BODY_MAX="5000"
# COMMUNITY_QUESTIONS_PER_DAY="5"
# COMMUNITY_ANSWERS_PER_DAY="20"
# SPEAKER_INVITATION_TTL_HOURS="168"
# EMAIL_VERIFICATION_TTL_HOURS="24"

# HIRING_WORKSPACES_PER_MEMBER="1"
# HIRING_ACTIVE_JOBS_PER_WORKSPACE="1"
# HIRING_SAVED_SEARCHES_MAX="20"
# HIRING_CANDIDATE_LISTS_MAX="20"
# HIRING_CANDIDATE_LIST_ENTRIES_MAX="200"
# HIRING_NOTE_MAX_CHARS="5000"
# HIRING_JOB_TITLE_MAX="160"
# HIRING_JOB_BODY_MAX="15000"
# HIRING_INVITATION_TTL_HOURS="168"

# ---------------------------------------------------------------------------
# Dev / test only — never enable in production
# ---------------------------------------------------------------------------

# Isolated test database (Vitest). Not used by `npm start` / `npm run worker`.
DATABASE_URL_TEST="postgresql://USER@127.0.0.1:5432/podtest_test?schema=public"

# Local Next.js port helper for `npm run dev`
# DEV_WEB_PORT="3000"

# Optional local AI demo stub — NON-PRODUCTION ONLY. UI-labeled when enabled.
# Forbidden when NODE_ENV=production (AI_ALLOW_STUB / AI_DEMO_STUB cannot override).
# AI_DEMO_STUB="true"
# AI_ALLOW_STUB="true"
# AI_PROVIDER=stub

# Mail sink: development-only file writes under STORAGE_ROOT/mail-sink.
# Disabled under NODE_ENV=production. Outbound email is not required for the
# current Kariyer Portresi MVP launch; use bootstrap:host --mark-email-verified
# for trusted host setup. Do not rely on the mail sink in production.
